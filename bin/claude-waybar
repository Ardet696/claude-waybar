class Popup:
    """Layer-shell panel under the bar module; rebuilt every second, Esc or click closes."""

    def __init__(self, store, view="sessions"):
        import gi
        gi.require_version("Gtk", "4.0")
        gi.require_version("Gtk4LayerShell", "1.0")
        from gi.repository import GLib, Gtk, Gdk, Pango, Gtk4LayerShell as LayerShell
        self.GLib, self.Gtk, self.Gdk, self.Pango, self.LayerShell = GLib, Gtk, Gdk, Pango, LayerShell
        self.store = store
        self.view = view
        self.processes = ProcessScanner()
        self.app = Gtk.Application(application_id="io.github.ardet696.claudewaybar")
        self.app.connect("activate", self._build)
        self.window = None

    def run(self):
        import gi
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        GLibUnix.signal_add(self.GLib.PRIORITY_DEFAULT, signal.SIGTERM, self._quit)
        return self.app.run([])

    def _quit(self, *_):
        self.app.quit()
        return False

    def _build(self, app):
        Gtk, LayerShell = self.Gtk, self.LayerShell
        css = Gtk.CssProvider()
        css.load_from_string(POPUP_CSS)
        Gtk.StyleContext.add_provider_for_display(
            self.Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.window = Gtk.ApplicationWindow(application=app)
        self.window.set_resizable(False)
        LayerShell.init_for_window(self.window)
        LayerShell.set_namespace(self.window, "claude-waybar")
        LayerShell.set_layer(self.window, LayerShell.Layer.OVERLAY)
        LayerShell.set_anchor(self.window, LayerShell.Edge.TOP, True)
        LayerShell.set_anchor(self.window, LayerShell.Edge.LEFT, True)
        LayerShell.set_margin(self.window, LayerShell.Edge.TOP, 6)
        LayerShell.set_margin(self.window, LayerShell.Edge.LEFT, POPUP_MARGIN_LEFT)
        LayerShell.set_keyboard_mode(self.window, LayerShell.KeyboardMode.ON_DEMAND)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self._on_key)
        self.window.add_controller(keys)
        click = Gtk.GestureClick()
        click.connect("released", self._on_click)
        self.window.add_controller(click)

        root = self._box(vertical=True, spacing=8, name="frame")
        root.set_size_request(400, -1)
        tabs = self._box(spacing=6)
        self.tab_buttons = {}
        for view, title in (("sessions", "Sessions"), ("agents", "Agents")):
            button = Gtk.Button(label=title)
            button.add_css_class("tab")
            button.connect("clicked", lambda _b, v=view: self._show(v))
            tabs.append(button)
            self.tab_buttons[view] = button
        root.append(tabs)

        self.body = self._box(vertical=True)
        scroller = Gtk.ScrolledWindow(propagate_natural_height=True,
                                      max_content_height=POPUP_MAX_HEIGHT)
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_child(self.body)
        root.append(scroller)
        self.content = None
        self.window.set_child(root)

        self._refresh()
        self.GLib.timeout_add_seconds(1, self._refresh)
        self.window.present()

    def _on_key(self, _controller, key, *_):
        if key == self.Gdk.KEY_Escape:
            self._quit()
            return True
        if key == self.Gdk.KEY_Tab:
            self._show("agents" if self.view == "sessions" else "sessions")
            return True
        return False

    def _on_click(self, _gesture, _n, x, y):
        widget = self.window.pick(x, y, self.Gtk.PickFlags.DEFAULT)
        while widget is not None:
            if isinstance(widget, self.Gtk.Button):
                return
            widget = widget.get_parent()
        self._quit()

    def _show(self, view):
        self.view = view
        self._refresh()

    def _refresh(self):
        sessions = sorted(self.store.load(), key=lambda s: -s.last_active)
        running = sum(s.agent_count("running") for s in sessions)
        self.tab_buttons["agents"].set_label(f"Agents ({running})" if running else "Agents")
        for view, button in self.tab_buttons.items():
            (button.add_css_class if view == self.view else button.remove_css_class)("active")

        content = self._box(vertical=True, spacing=8)
        fill = self._fill_agents if self.view == "agents" else self._fill_sessions
        fill(content, sessions)
        self.body.append(content)
        if self.content is not None:
            self.body.remove(self.content)
        self.content = content
        return True

    def _fill_sessions(self, content, sessions):
        if not sessions:
            content.append(self._label("No Claude Code sessions", "empty"))
        for i, s in enumerate(sessions):
            if i:
                content.append(self.Gtk.Separator())
            for widget in self._session_widgets(s):
                content.append(widget)
        for limit in SessionStore.latest_limits(sessions):
            sub = f"resets in {fmt_span(limit.resets_in)}" if limit.resets_in else ""
            content.append(self._meter(limit.label, limit.pct / 100, sub))

    def _fill_agents(self, content, sessions):
        sessions = [s for s in sessions if s.agents]
        if not sessions:
            content.append(self._label("No subagents in live sessions", "empty"))
        for i, s in enumerate(sessions):
            if i:
                content.append(self.Gtk.Separator())
            content.append(self._agents_header(s))
            done = [a for a in s.agents if a.state == "done"]
            shown = [a for a in s.agents if a.state != "done"] + done[:DONE_AGENTS_SHOWN]
            for agent in shown:
                content.append(self._agent_card(agent))
            if len(done) > DONE_AGENTS_SHOWN:
                content.append(self._label(f"+{len(done) - DONE_AGENTS_SHOWN} earlier finished", "sub"))

    def _agents_header(self, s):
        box = self._box(vertical=True, spacing=2)
        box.append(self._label(f'<span foreground="{C["peach"]}">◆</span> {escape(s.project)}', "header"))
        count, rss = self.processes.usage(s.sid)
        facts = [escape(s.model), f"{s.ctx_ratio:.0%} ctx",
                 f'{s.agent_count("running")} running', escape(s.agent_summary)]
        if count:
            facts.append(f"{count} procs {fmt_bytes(rss)}")
        box.append(self._label(" · ".join(facts), "sub"))
        return box

    def _agent_card(self, a):
        card = self._box(vertical=True, spacing=4, css="card")
        color = AGENT_COLOR[a.state]
        top = self._box(spacing=8)
        title = self._label(f'<span foreground="{color}">●</span> {escape(a.description)}',
                            "agent-title", max_chars=38)
        title.set_hexpand(True)
        top.append(title)
        top.append(self._label(f'<span foreground="{color}">{a.state.upper()}</span>', "state", xalign=1))
        card.append(top)
        card.append(self._label(f"{escape(a.kind)} · {escape(a.model)} · {fmt_clock(a.elapsed)}", "sub"))
        if a.activity:
            card.append(self._label(escape(a.activity), "caption", max_chars=52))
        card.append(self._gauge(a.ctx_ratio, 5))
        stats = [f"ctx {fmt_tokens(a.ctx_used)}/{fmt_tokens(a.ctx_size)} {a.ctx_ratio:.0%}",
                 f"{a.tools} tools", f"{fmt_tokens(a.output_tokens)} out"]
        if a.state != "done":
            stats.append(f"quiet {fmt_clock(a.quiet_for)}")
        card.append(self._label(" · ".join(stats), "sub"))
        return card

    def _session_widgets(self, s):
        Gtk = self.Gtk
        color = STATE_COLOR[s.state]
        header = self._label(f'<span foreground="{C["peach"]}">◆</span> {escape(s.project)}', "header")

        status = self._box(spacing=12, css="card")
        status.append(self._label(f'<span foreground="{color}" size="xx-large">●</span>'))
        left = self._box(vertical=True)
        left.append(self._label(s.model, "model"))
        left.append(self._label(f"effort · {s.effort}" if s.effort else "", "sub"))
        left.set_hexpand(True)
        status.append(left)
        right = self._box(vertical=True)
        right.append(self._label(f'<span foreground="{color}">{s.state.upper()}</span>',
                                 "state", xalign=1))
        since = fmt_clock(s.now - s.since)
        activity = since if s.state == "idle" else f"{escape(s.detail)} · {since}"
        right.append(self._label(activity, "sub", xalign=1))
        status.append(right)

        ctx = self._meter("CONTEXT", s.ctx_ratio,
                          f"{fmt_tokens(s.ctx_used)} of {fmt_tokens(s.ctx_size)}")

        agents = self._tile("AGENTS", f'{s.agent_count("running")} running', s.agent_summary, "mauve")
        return [header, status, ctx, agents]

    def _meter(self, caption, ratio, sub):
        Gtk = self.Gtk
        card = self._box(vertical=True, spacing=6, css="card")
        row = self._box()
        cap = self._label(caption, "caption")
        cap.set_hexpand(True)
        row.append(cap)
        row.append(self._label(f"{ratio:.0%}", "value", xalign=1))
        card.append(row)
        card.append(self._gauge(ratio, 8))
        if sub:
            card.append(self._label(sub, "sub"))
        return card

    def _gauge(self, ratio, height):
        bar = self.Gtk.DrawingArea()
        bar.set_content_height(height)
        bar.set_draw_func(self._draw_gauge, ratio)
        return bar

    @staticmethod
    def _draw_gauge(_area, cr, w, h, ratio):
        import math

        def rounded(width):
            r = h / 2
            cr.new_sub_path()
            cr.arc(width - r, r, r, -math.pi / 2, math.pi / 2)
            cr.arc(r, r, r, math.pi / 2, 3 * math.pi / 2)
            cr.close_path()

        cr.set_source_rgb(*(v / 255 for v in _hex(C["track"])))
        rounded(w)
        cr.fill()
        if ratio <= 0:
            return
        import cairo
        grad = cairo.LinearGradient(0, 0, w, 0)
        for stop in (0.0, 0.3, 0.6, 0.8, 1.0):
            grad.add_color_stop_rgb(stop, *(v / 255 for v in _hex(heat(stop))))
        cr.set_source(grad)
        rounded(max(w * ratio, h))
        cr.fill()

    def _tile(self, caption, value, sub, accent):
        tile = self._box(vertical=True, spacing=2, css="card")
        inner = self._box(vertical=True, spacing=2, css="tile")
        inner.add_css_class(f"accent-{accent}")
        inner.append(self._label(caption, "caption"))
        inner.append(self._label(value, "value"))
        inner.append(self._label(sub, "sub"))
        tile.append(inner)
        return tile

    def _box(self, vertical=False, spacing=0, css=None, name=None, homogeneous=False):
        Gtk = self.Gtk
        orient = Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL
        box = Gtk.Box(orientation=orient, spacing=spacing, homogeneous=homogeneous)
        if css:
            box.add_css_class(css)
        if name:
            box.set_name(name)
        return box

    def _label(self, markup, css=None, xalign=0, max_chars=None):
        label = self.Gtk.Label(xalign=xalign)
        label.set_markup(markup)
        if max_chars:
            label.set_ellipsize(self.Pango.EllipsizeMode.END)
            label.set_max_width_chars(max_chars)
        if css:
            label.add_css_class(css)
        return label


def focus_session():
    top = SessionStore.most_recent(SessionStore().load())
    if top is None or not top.pid:
        return 1
    clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"],
                                        capture_output=True, text=True).stdout or "[]")
    client_pids = {c["pid"] for c in clients}
    pid = top.pid
    while pid > 1:
        if pid in client_pids:
            subprocess.run(["hyprctl", "dispatch", "focuswindow", f"pid:{pid}"],
                           capture_output=True)
            return 0
        try:
            pid = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
        except (OSError, IndexError, ValueError):
            return 1
    return 1


def toggle_popup(view):
    try:
        pid = int(POPUP_PID.read_text())
        if _pid_alive(pid):
            os.kill(pid, signal.SIGTERM)
            return 0
    except (OSError, ValueError):
        pass

    if LAYER_SHELL_LIB not in os.environ.get("LD_PRELOAD", ""):
        env = dict(os.environ, LD_PRELOAD=LAYER_SHELL_LIB)
        os.execve(sys.executable, [sys.executable, *sys.argv], env)

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    POPUP_PID.write_text(str(os.getpid()))
    try:
        return Popup(SessionStore(), view).run()
    finally:
        POPUP_PID.unlink(missing_ok=True)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "data":
        print(json.dumps(BarRenderer().render(SessionStore(tail_limit=BAR_TAIL_BYTES).load())))
        return 0
    if cmd == "focus":
        return focus_session()
    if cmd == "popup":
        return toggle_popup("agents" if sys.argv[2:] == ["agents"] else "sessions")
    print(f"{Path(sys.argv[0]).name}: {Path(sys.argv[0]).name} data|popup [agents]|focus", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
