#!/usr/bin/env python3
"""Claude Code sessions for waybar: bar text, details popup, window focus.

State comes from claude-waybar-hook (activity, agents) and claude-waybar-statusline
(model, effort, context, rate limits), both under $XDG_RUNTIME_DIR/claude-waybar.
Hosts that never run the statusLine (VS Code) and subagents are read from their
JSONL transcripts instead.

Dependencies: python-gobject, gtk4, gtk4-layer-shell (popup), hyprland (focus)
"""

import json
import os
import re
import signal
import subprocess
import sys
import time
from datetime import datetime
from html import escape
from pathlib import Path

STATE_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "claude-waybar"
POPUP_PID = STATE_DIR / "popup.pid"
LAYER_SHELL_LIB = "/usr/lib/libgtk4-layer-shell.so"

WAITING_TTL = 600
STALE_TTL = 6 * 3600
BAR_CELLS = 10
POPUP_MARGIN_LEFT = int(os.environ.get("CLAUDE_WAYBAR_POPUP_X", 330))
POPUP_MAX_HEIGHT = int(os.environ.get("CLAUDE_WAYBAR_POPUP_MAX_HEIGHT", 900))
CLAUDE_HOME = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
BAR_TAIL_BYTES = 512 * 1024
DEFAULT_WINDOW = 200_000
EXTENDED_WINDOW = 1_000_000
AGENT_STALL_TTL = 15 * 60
AGENT_STOP_GRACE = 2
DONE_AGENTS_SHOWN = 4
PROCESS_SCAN_INTERVAL = 3

C = {
    "blue": "#89b4fa",
    "yellow": "#f9e2af",
    "mauve": "#cba6f7",
    "green": "#a6e3a1",
    "red": "#f38ba8",
    "peach": "#fab387",
    "teal": "#94e2d5",
    "track": "#313244",
    "dim": "#6c7086",
}
STATE_COLOR = {"idle": C["blue"], "running": C["yellow"], "waiting": C["mauve"], "agents": C["teal"]}
AGENT_MANAGEMENT_TOOLS = {"Agent", "Task", "SendMessage", "TaskStop"}
AGENT_COLOR = {"running": C["yellow"], "stalled": C["red"], "stopped": C["peach"], "done": C["green"]}
AGENT_ORDER = {"running": 0, "stalled": 1, "stopped": 2, "done": 3}
LEGACY_STATE = {"working": "running", "thinking": "running", "done": "waiting"}


def _hex(c):
    return tuple(int(c[i:i + 2], 16) for i in (1, 3, 5))


def mix(a, b, t):
    pa, pb = _hex(a), _hex(b)
    return "#" + "".join(f"{round(x + (y - x) * t):02x}" for x, y in zip(pa, pb))


def heat(t):
    t = min(max(t, 0.0), 1.0)
    if t < 0.6:
        return mix(C["green"], C["yellow"], t / 0.6)
    return mix(C["yellow"], C["red"], (t - 0.6) / 0.4)


def fmt_tokens(n):
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    return f"{n // 1000}k" if n >= 1000 else str(n)


def fmt_clock(sec):
    sec = int(max(sec, 0))
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def fmt_span(sec):
    sec = int(max(sec, 0))
    d, rem = divmod(sec, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    return f"{d}d{h}h" if d else f"{h}h{m:02d}m" if h else f"{m}m"


def fmt_bytes(n):
    for unit, size in (("G", 1 << 30), ("M", 1 << 20)):
        if n >= size:
            return f"{n / size:.1f}{unit}"
    return f"{n >> 10}k"


def fmt_model(model_id):
    match = re.match(r"claude-([a-z]+)-(\d+)(?:-(\d{1,2}))?(?:-\d{8})?$", model_id or "")
    if not match:
        return model_id or "Claude"
    family, major, minor = match.groups()
    return f"{family.capitalize()} {major}.{minor}" if minor else f"{family.capitalize()} {major}"


def _read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def _pid_alive(pid):
    return bool(pid) and Path(f"/proc/{pid}").exists()


class Limit:
    def __init__(self, label, raw, now):
        self.label = label
        self.pct = raw.get("used_percentage") or 0
        resets = raw.get("resets_at")
        self.resets_in = resets - now if resets else None


class Transcript:
    """Incremental reader of a JSONL transcript; keeps only derived fields in memory."""

    _RELEVANT = (b'"type":"assistant"', b'"type":"user"')

    def __init__(self, path, tail_limit=None):
        self.path = path
        self._tail_limit = tail_limit
        self._reset()

    def _reset(self):
        self._offset = 0
        self._message_id = None
        self._message_output = 0
        self.mtime = 0
        self.started = None
        self.last_ts = None
        self.model = None
        self.effort = None
        self.ctx_used = 0
        self.tools = 0
        self.output_tokens = 0
        self.last_text = ""
        self.last_tool = ""
        self.finished = False
        self.notified_by = None

    def refresh(self):
        try:
            stat = os.stat(self.path)
        except OSError:
            return self
        if stat.st_size < self._offset:
            self._reset()
        self.mtime = stat.st_mtime
        if stat.st_size == self._offset:
            return self
        start = self._offset
        partial = False
        if start == 0 and self._tail_limit and stat.st_size > self._tail_limit:
            start = stat.st_size - self._tail_limit
            partial = True
        with open(self.path, "rb") as f:
            f.seek(start)
            chunk = f.read()
        end = chunk.rfind(b"\n")
        if end < 0:
            return self
        self._offset = start + end + 1
        lines = chunk[:end].split(b"\n")
        for line in lines[1:] if partial else lines:
            if any(marker in line for marker in self._RELEVANT):
                self._ingest(line)
        return self

    def _ingest(self, line):
        try:
            record = json.loads(line)
        except ValueError:
            return
        kind = record.get("type")
        if kind not in ("assistant", "user"):
            return
        self._touch(record.get("timestamp"))
        if kind == "user":
            self.finished = False
            self._note_prompt(record)
            return
        message = record.get("message") or {}
        self.finished = message.get("stop_reason") not in (None, "tool_use")
        self.effort = record.get("effort") or self.effort
        if message.get("model") not in (None, "<synthetic>"):
            self.model = message["model"]
            self._account(message)
        for block in message.get("content") or []:
            if block.get("type") == "tool_use":
                self.tools += 1
                self.last_tool = self._describe_tool(block)
            elif block.get("type") == "text" and block.get("text", "").strip():
                self.last_text = block["text"].strip().splitlines()[0][:200]

    def _note_prompt(self, record):
        content = (record.get("message") or {}).get("content")
        if isinstance(content, list) and all(b.get("type") == "tool_result" for b in content):
            return
        self.notified_by = None
        if (record.get("origin") or {}).get("kind") == "task-notification":
            match = re.search(r"<tool-use-id>([^<]+)</tool-use-id>", str(content))
            self.notified_by = match.group(1) if match else None

    def _touch(self, stamp):
        try:
            ts = datetime.fromisoformat(stamp).timestamp()
        except (TypeError, ValueError):
            return
        self.started = self.started or ts
        self.last_ts = ts

    def _account(self, message):
        usage = message.get("usage") or {}
        used = sum(usage.get(k, 0) for k in
                   ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
        if used:
            self.ctx_used = used
        output = usage.get("output_tokens", 0)
        if message.get("id") != self._message_id:
            self._message_id = message.get("id")
            self._message_output = 0
        self.output_tokens += output - self._message_output
        self._message_output = output

    @staticmethod
    def _describe_tool(block):
        args = block.get("input") or {}
        for key in ("description", "command", "file_path", "pattern", "url", "prompt"):
            value = args.get(key)
            if isinstance(value, str) and value.strip():
                return f"{block.get('name', 'tool')} · {value.strip().splitlines()[0][:200]}"
        return block.get("name", "tool")


class TranscriptStore:
    def __init__(self, tail_limit=None):
        self._tail_limit = tail_limit
        self._open = {}
        self._located = {}

    def locate(self, sid):
        if sid not in self._located:
            match = next((CLAUDE_HOME / "projects").glob(f"*/{sid}.jsonl"), None)
            if match is None:
                return None
            self._located[sid] = str(match)
        return self._located[sid]

    def get(self, path):
        transcript = self._open.get(path)
        if transcript is None:
            transcript = self._open[path] = Transcript(path, self._tail_limit)
        return transcript.refresh()

    def agents(self, session_transcript):
        """Pairs of (agent id, metadata, transcript) for a session's subagents."""
        root = Path(session_transcript).with_suffix("") / "subagents"
        found = []
        for meta_path in root.glob("agent-*.meta.json"):
            log = meta_path.with_name(meta_path.name.replace(".meta.json", ".jsonl"))
            if self._tail_limit and not self._recent(log):
                continue
            agent_id = log.stem.removeprefix("agent-")
            found.append((agent_id, _read_json(meta_path), self.get(str(log))))
        return found


    @staticmethod
    def _recent(path):
        try:
            return time.time() - path.stat().st_mtime <= AGENT_STALL_TTL
        except OSError:
            return False


class ContextWindows:
    """Window size per model, learned from sessions that do report it via statusLine."""

    def __init__(self):
        self._known = {}

    def learn(self, status):
        model_id = (status.get("model") or {}).get("id")
        size = (status.get("context_window") or {}).get("context_window_size")
        if model_id and size:
            self._known[model_id.split("[")[0]] = size

    def size_for(self, model_id, used):
        size = self._known.get(model_id, DEFAULT_WINDOW)
        return EXTENDED_WINDOW if used > size else size


class Agent:
    def __init__(self, agent_id, meta, transcript, stopped_at, windows, now):
        self.agent_id = agent_id
        self._meta = meta
        self._transcript = transcript
        self._stopped_at = stopped_at
        self._windows = windows
        self.now = now

    @property
    def tool_use_id(self):
        return self._meta.get("toolUseId")

    @property
    def description(self):
        return self._meta.get("description") or self.agent_id

    @property
    def kind(self):
        return self._meta.get("agentType") or "agent"

    @property
    def state(self):
        t = self._transcript
        if t.finished:
            return "done"
        if self._stopped_at and t.mtime <= self._stopped_at + AGENT_STOP_GRACE:
            return "stopped"
        return "stalled" if self.now - t.mtime > AGENT_STALL_TTL else "running"

    @property
    def model(self):
        return fmt_model(self._transcript.model or self._meta.get("model"))

    @property
    def elapsed(self):
        t = self._transcript
        end = self.now if self.state == "running" else (t.last_ts or t.mtime)
        return end - (t.started or end)

    @property
    def activity(self):
        t = self._transcript
        return (t.last_text or t.last_tool) if t.finished else (t.last_tool or t.last_text)

    @property
    def quiet_for(self):
        return self.now - self._transcript.mtime

    @property
    def last_active(self):
        return self._transcript.mtime

    @property
    def tools(self):
        return self._transcript.tools

    @property
    def output_tokens(self):
        return self._transcript.output_tokens

    @property
    def ctx_used(self):
        return self._transcript.ctx_used

    @property
    def ctx_size(self):
        return self._windows.size_for(self._transcript.model, self.ctx_used)

    @property
    def ctx_ratio(self):
        return min(self.ctx_used / self.ctx_size, 1.0)


class ProcessScanner:
    """Counts each session's child processes through the session id in their environment."""

    _MARKER = b"CLAUDE_CODE_SESSION_ID="
    _PAGE = os.sysconf("SC_PAGE_SIZE")

    def __init__(self):
        self._at = 0
        self._usage = {}

    def usage(self, sid):
        now = time.monotonic()
        if now - self._at >= PROCESS_SCAN_INTERVAL:
            self._usage = self._scan()
            self._at = now
        return self._usage.get(sid, (0, 0))

    def _scan(self):
        usage = {}
        for entry in Path("/proc").iterdir():
            if not entry.name.isdigit():
                continue
            try:
                sid = self._session_of((entry / "environ").read_bytes())
                if sid is None:
                    continue
                rss = int((entry / "statm").read_text().split()[1]) * self._PAGE
            except (OSError, ValueError, IndexError):
                continue
            count, total = usage.get(sid, (0, 0))
            usage[sid] = (count + 1, total + rss)
        return usage

    def _session_of(self, environ):
        for var in environ.split(b"\0"):
            if var.startswith(self._MARKER):
                return var[len(self._MARKER):].decode()
        return None


class Session:
    def __init__(self, sid, hook, status, status_mtime, transcripts, windows, now):
        self.sid = sid
        self._hook = hook
        self._status = status
        self._status_mtime = status_mtime
        self._transcripts = transcripts
        self._windows = windows
        self._agents = None
        self.now = now

    @property
    def _transcript_path(self):
        return self._status.get("transcript_path") or self._transcripts.locate(self.sid)

    @property
    def _transcript(self):
        path = self._transcript_path
        return self._transcripts.get(path) if path else None

    @property
    def project(self):
        ws = self._status.get("workspace") or {}
        path = ws.get("project_dir") or self._status.get("cwd")
        return Path(path).name if path else self._hook.get("project", "claude")

    @property
    def _managing_agents(self):
        if self._hook.get("state") == "running" and self._hook.get("detail") in AGENT_MANAGEMENT_TOOLS:
            return True
        transcript = self._transcript
        if transcript is None or transcript.finished or not transcript.notified_by:
            return False
        return any(a.tool_use_id == transcript.notified_by for a in self.agents)

    @property
    def state(self):
        state = LEGACY_STATE.get(self._hook.get("state"), self._hook.get("state", "idle"))
        if self._managing_agents:
            return "running"
        if state != "running" and self._hook.get("detail") != "permission" and self.agent_count("running"):
            return "agents"
        if state == "waiting" and self.now - self.since > WAITING_TTL:
            return "idle"
        return state if state in STATE_COLOR else "idle"

    @property
    def detail(self):
        if self._managing_agents:
            return "managing agents"
        state = self.state
        if state == "agents":
            count = self.agent_count("running")
            return f"waiting for {count} agents" if count > 1 else "waiting for agent"
        if state == "idle":
            return "idle"
        return self._hook.get("detail") or state

    @property
    def since(self):
        return self._hook.get("ts", self._status_mtime)

    @property
    def last_active(self):
        return max(self._hook.get("ts", 0), self._status_mtime)

    @property
    def pid(self):
        return self._hook.get("pid")

    @property
    def alive(self):
        if self.pid:
            return _pid_alive(self.pid)
        return self.now - self.last_active < STALE_TTL

    @property
    def model(self):
        name = (self._status.get("model") or {}).get("display_name")
        if name:
            return name
        transcript = self._transcript
        return fmt_model(transcript.model if transcript else None)

    @property
    def effort(self):
        level = (self._status.get("effort") or {}).get("level")
        if level:
            return level
        transcript = self._transcript
        return transcript.effort if transcript else None

    @property
    def ctx_size(self):
        size = (self._status.get("context_window") or {}).get("context_window_size")
        if size:
            return size
        transcript = self._transcript
        return self._windows.size_for(transcript.model if transcript else None, self.ctx_used)

    @property
    def ctx_used(self):
        usage = (self._status.get("context_window") or {}).get("current_usage") or {}
        used = sum(usage.get(k, 0) for k in
                   ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
        if used:
            return used
        transcript = self._transcript
        return transcript.ctx_used if transcript else 0

    @property
    def ctx_ratio(self):
        return min(self.ctx_used / self.ctx_size, 1.0)

    @property
    def agents(self):
        if self._agents is None:
            path = self._transcript_path
            stopped = self._hook.get("stopped_agents") or {}
            found = self._transcripts.agents(path) if path else []
            self._agents = sorted(
                (Agent(aid, meta, log, stopped.get(aid), self._windows, self.now)
                 for aid, meta, log in found),
                key=lambda a: (AGENT_ORDER[a.state], -a.last_active))
        return self._agents

    def agent_count(self, state):
        return sum(a.state == state for a in self.agents)

    @property
    def agent_summary(self):
        parts = [f"{self.agent_count(state)} {state}"
                 for state in ("stalled", "stopped", "done") if self.agent_count(state)]
        return " · ".join(parts) or "0 done"

    @property
    def limits(self):
        raw = self._status.get("rate_limits") or {}
        return [Limit(label, raw[key], self.now)
                for key, label in (("five_hour", "5H LIMIT"), ("seven_day", "7D LIMIT"))
                if key in raw]


class SessionStore:
    def __init__(self, root=STATE_DIR, tail_limit=None):
        self.root = root
        self.transcripts = TranscriptStore(tail_limit)

    def load(self):
        now = time.time()
        windows = ContextWindows()
        for path in self.root.glob("*.status"):
            windows.learn(_read_json(path))
        ids = {p.stem for p in self.root.glob("*.json")}
        ids |= {p.stem for p in self.root.glob("*.status")}
        sessions = []
        for sid in ids:
            status_path = self.root / f"{sid}.status"
            try:
                mtime = status_path.stat().st_mtime
            except OSError:
                mtime = 0
            s = Session(sid, _read_json(self.root / f"{sid}.json"),
                        _read_json(status_path), mtime, self.transcripts, windows, now)
            if s.alive:
                sessions.append(s)
        return sorted(sessions, key=lambda s: (s.project, s.sid))

    @staticmethod
    def most_recent(sessions):
        return max(sessions, key=lambda s: s.last_active) if sessions else None

    @staticmethod
    def latest_limits(sessions):
        reporting = [s for s in sessions if s.limits]
        return SessionStore.most_recent(reporting).limits if reporting else []


class BarRenderer:
    def render(self, sessions):
        top = SessionStore.most_recent(sessions)
        if top is None:
            return {"text": ""}
        dots = " ".join(self._span(STATE_COLOR[s.state], "●") for s in sessions)
        text = f"{dots} {escape(top.detail)} {self._gauge(top.ctx_ratio)}"
        return {"text": text, "class": top.state, "tooltip": self._tooltip(sessions)}

    @staticmethod
    def _span(color, s):
        return f'<span foreground="{color}">{s}</span>'

    def _gauge(self, ratio):
        filled = round(ratio * BAR_CELLS)
        if ratio > 0 and filled == 0:
            filled = 1
        cells = [self._span(heat(i / (BAR_CELLS - 1)), "━") for i in range(filled)]
        cells += [self._span(C["track"], "━")] * (BAR_CELLS - filled)
        return "".join(cells)

    @staticmethod
    def _tooltip(sessions):
        lines = [f"<b>{escape(s.project)}</b>: {escape(s.detail)} · {s.ctx_ratio:.0%} context" for s in sessions]
        return "\n".join(lines + ["", "Click: details   Right-click: focus"])


